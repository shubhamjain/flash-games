{
  "name": "ruffle-flash-games",
  "private": true,
  "version": "1.0.0",
  "description": "Static Flash game gallery built for Cloudflare Pages",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "fetch:ruffle": "sh scripts/fetch-ruffle.sh",
    "preview": "node scripts/preview.mjs",
    "dev": "node scripts/preview.mjs --watch",
    "check": "node --check scripts/build.mjs && node --check scripts/preview.mjs"
  }
}
